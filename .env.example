# Kelly OS - Environment Variables
# Copy this to .env and fill in your values

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/kellyos"

# M-Pesa Daraja API
# Get these from https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY="your_consumer_key"
MPESA_CONSUMER_SECRET="your_consumer_secret"
MPESA_PASSKEY="your_passkey"
MPESA_SHORTCODE="your_shortcode"
MPESA_PAYBILL_NUMBER="your_paybill_number"
MPESA_WEBHOOK_SECRET="your_webhook_secret"
MPESA_CALLBACK_URL="https://yourdomain.com/api/webhooks/mpesa/stkpush"
MPESA_ENVIRONMENT="sandbox" # or "production"

# Equity Eazypay
# Get these from Equity Bank
EAZYPAY_MERCHANT_ID="your_merchant_id"
EAZYPAY_API_KEY="your_api_key"
EAZYPAY_API_SECRET="your_api_secret"
EAZYPAY_WEBHOOK_SECRET="your_webhook_secret"
EAZYPAY_WEBHOOK_URL="https://yourdomain.com/api/webhooks/eazypay"
EAZYPAY_ENVIRONMENT="sandbox" # or "production"

# Security
ENCRYPTION_KEY="your_encryption_key_32_chars"
JWT_SECRET="your_jwt_secret"

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
